import java.util.concurrent.Semaphore;
import java.util.function.IntConsumer;

public class FizzBuzzMultithreaded {

    static class FizzBuzz {
        private int n;
        private Semaphore semFizz     = new Semaphore(0);
        private Semaphore semBuzz     = new Semaphore(0);
        private Semaphore semFizzBuzz = new Semaphore(0);
        private Semaphore semNumber   = new Semaphore(1);

        public FizzBuzz(int n) {
            this.n = n;
        }

        public void fizz(Runnable printFizz) throws InterruptedException {
            for (int i = 3; i <= n; i += 3) {
                if (i % 5 != 0) {
                    semFizz.acquire();
                    // printFizz.run() outputs "fizz".
                    printFizz.run();
                    semNumber.release();
                }
            }
        }

        public void buzz(Runnable printBuzz) throws InterruptedException {
            for (int i = 5; i <= n; i += 5) {
                if (i % 3 != 0) {
                    semBuzz.acquire();
                    // printBuzz.run() outputs "buzz".
                    printBuzz.run();
                    semNumber.release();
                }
            }
        }

        public void fizzbuzz(Runnable printFizzBuzz) throws InterruptedException {
            for (int i = 15; i <= n; i += 15) {
                semFizzBuzz.acquire();
                // printFizzBuzz.run() outputs "fizzbuzz".
                printFizzBuzz.run();
                semNumber.release();
            }
        }

        public void number(IntConsumer printNumber) throws InterruptedException {
            for (int i = 1; i <= n; i++) {
                semNumber.acquire();
                if (i % 15 == 0)      semFizzBuzz.release();
                else if (i % 3 == 0)  semFizz.release();
                else if (i % 5 == 0)  semBuzz.release();
                else {
                    // printNumber.accept(x) outputs "x".
                    printNumber.accept(i);
                    semNumber.release();
                }
            }
        }
    }

    public static void main(String[] args) throws Exception {
        FizzBuzz fb = new FizzBuzz(15);
        Thread t1 = new Thread(() -> { try { fb.fizz(() -> System.out.print("fizz")); } catch (Exception e) { e.printStackTrace(); } });
        Thread t2 = new Thread(() -> { try { fb.buzz(() -> System.out.print("buzz")); } catch (Exception e) { e.printStackTrace(); } });
        Thread t3 = new Thread(() -> { try { fb.fizzbuzz(() -> System.out.print("fizzbuzz")); } catch (Exception e) { e.printStackTrace(); } });
        Thread t4 = new Thread(() -> { try { fb.number(x -> System.out.print(x)); } catch (Exception e) { e.printStackTrace(); } });
        t1.start(); t2.start(); t3.start(); t4.start();
        t1.join(); t2.join(); t3.join(); t4.join();
    }
}
